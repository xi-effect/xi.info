# Скопируйте в docs-agent/.env.docs.local. Этот файл не коммитить.
# Имена SECRET_* — это placeholders, которые агент вводит в форму входа.
# Playwright MCP подставляет значения на своей стороне (--secrets).
DOCS_APP_URL=https://app.sovlium.ru
DOCS_SUPPORT_URL=https://support.sovlium.ru
SECRET_DOCS_TUTOR_EMAIL=
SECRET_DOCS_TUTOR_PASSWORD=
SECRET_DOCS_STUDENT_EMAIL=
SECRET_DOCS_STUDENT_PASSWORD=
