{
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://support.sovlium.ru/",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://support.sovlium.ru/:path*",
      "permanent": true
    },
    {
      "source": "/subscribe",
      "destination": "https://app.sovlium.ru/?profile=subscription",
      "permanent": false
    },
    {
      "source": "/subscribe/",
      "destination": "https://app.sovlium.ru/?profile=subscription",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "x-robots-tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
